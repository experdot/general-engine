{
  "name": "general-engine-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @general-engine/gallery dev",
    "build": "pnpm -r build",
    "build:gallery": "pnpm --filter @general-engine/gallery build",
    "build:lib": "pnpm --filter general-engine build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@types/node": "^24.0.3",
    "eslint": "^9.29.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.0.0"
  }
}
